# 외부 API URL (브라우저에서 접근 가능한 주소)
NEXT_PUBLIC_API_URL=http://localhost:8100/api

# 내부 API URL (서버 사이드 전용, Docker 내부 네트워크 등)
# 설정하지 않으면 NEXT_PUBLIC_API_URL을 사용
API_URL_INTERNAL=http://localhost:8100/api

# 정적 이미지 호스트
NEXT_PUBLIC_IMAGE_HOST=https://static.mmrtr.shop

# 게임 정적 데이터(챔피언/스펠/아이템/룬 JSON) 호스트
# 실제 요청 경로: {호스트}/data/{DataDragon버전}/{로케일}/{파일}.json  (예: /data/16.16.1/ko/summoner.json)
# 버전은 시즌의 패치 버전(16.16)이 아니라 Data Dragon 버전(16.16.1)이다.
NEXT_PUBLIC_GAME_DATA_HOST=https://static.metapick.me

# 게임 정적 데이터를 Next 리라이트(/game-data/*)로 우회할지 여부.
# JSON 은 fetch 로 받으므로 CDN 이 Access-Control-Allow-Origin 을 내려주지 않으면 막힌다.
# 로컬 개발에서는 true 로 켜서 Next 서버가 대신 받아오게 한다(같은 출처 → CORS 없음).
# 운영은 CloudFront 응답 헤더 정책이 CORS 를 붙이므로 false 로 두고 CDN 을 직접 친다.
NEXT_PUBLIC_GAME_DATA_PROXY=false

# 로케일 리다이렉트를 301(영구)로 승격 (서버 전용)
# next-intl 기본값은 307(임시). SEO 상 링크 에쿼티를 넘기려면 301 이어야 하지만,
# 301 은 브라우저가 영구 캐시하므로 경로 규칙이 확정된 프로덕션에서만 true 로 켠다.
I18N_PERMANENT_REDIRECT=false

